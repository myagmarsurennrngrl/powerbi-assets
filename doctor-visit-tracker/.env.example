# ---------------------------------------------------------------------------
# Doctor Visit Tracker — example environment file
#
# HOW TO USE THIS FILE (for a non-technical person):
#   1. Make a copy of this file in the same folder and name the copy  .env
#   2. Replace every "REPLACE_ME" with the real value from your Supabase project
#   3. NEVER send the .env file by e-mail, chat, or put it on GitHub.
#      The .env file is already blocked from GitHub by the .gitignore file.
#
# Where do the values come from?
#   Supabase dashboard  →  your project  →  Project Settings  →  API
# ---------------------------------------------------------------------------

# The internet address of your Supabase project.
# Looks like: https://abcdefghijklmnop.supabase.co
EXPO_PUBLIC_SUPABASE_URL=REPLACE_ME

# The "anon" / "publishable" key.
# This one is SAFE to ship inside the mobile app — on its own it can do nothing,
# because every table is protected by Row Level Security in the database.
EXPO_PUBLIC_SUPABASE_ANON_KEY=REPLACE_ME

# Which e-mail endings are allowed to log in, separated by commas, no spaces.
# This is only a friendly hint shown in the app. The REAL check happens in the
# database, so changing this line does not let anyone in.
EXPO_PUBLIC_ALLOWED_EMAIL_DOMAINS=company.mn

# Shown on the Settings screen and stored with every check-in, so support can
# tell which app version produced a record.
EXPO_PUBLIC_APP_VERSION=0.1.0

# Set to "true" only in a development build if you want extra console logging.
EXPO_PUBLIC_DEBUG_LOGGING=false


# ===========================================================================
# SERVER-SIDE ONLY — never put these in the mobile app, never commit them.
# These belong in the Supabase dashboard or in EAS Secrets.
# They are listed here only so you know they exist.
# ===========================================================================

# SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME   # full database power — treat like a master key
# SUPABASE_DB_PASSWORD=REPLACE_ME        # direct Postgres password
# POWERBI_READER_PASSWORD=REPLACE_ME     # read-only reporting login for Power BI
