{
  "name": "doctor-visit-tracker",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:test": "node scripts/run-db-tests.mjs",
    "db:check-statements": "node scripts/check-statement-safe.mjs",
    "dev:code": "node scripts/dev-get-login-code.mjs",
    "lint": "expo lint"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "babel-preset-expo": "~57.0.0",
    "expo": "~57.0.8",
    "expo-application": "~57.0.2",
    "expo-constants": "~57.0.7",
    "expo-crypto": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-location": "~57.0.6",
    "expo-network": "~57.0.1",
    "expo-router": "~57.0.8",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "@types/react": "~19.2.2",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.4.2",
    "pg": "^8.22.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
