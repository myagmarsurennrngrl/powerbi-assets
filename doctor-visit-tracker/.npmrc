; expo-router pulls in web-only transitive packages (vaul -> @radix-ui -> react-dom)
; whose peer ranges are stricter than the React version Expo SDK 57 pins.
; Those packages are never bundled for iOS/Android, so relaxing peer resolution
; is safe here and matches Expo's own guidance for SDK 57 + npm.
legacy-peer-deps=true
save-exact=false

